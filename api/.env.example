RPC_URL=http://localhost:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
# Opcional: misma dirección que en la dapp si usas owner “configurado” por .env
CONTRACT_OWNER_ADDRESS=
# Bloque donde se desplegó el contrato (eth_getLogs desde aquí; 0 = desde génesis)
CONTRACT_DEPLOY_BLOCK=0
# En desarrollo local (npm run dev): use su puerto y Mongo en el host.
PORT=3005
# MongoDB: en Docker Compose usar mongodb://mongo:27017/rbac_market
# Desde el host contra el puerto publicado: mongodb://127.0.0.1:27019/rbac_market
MONGODB_URI=mongodb://127.0.0.1:27019/rbac_market
# Redis opcional (si no se define, API funciona sin caché/indexador)
# En Docker Compose se usa redis://redis:6379
# Desde el host (puerto publicado): redis://127.0.0.1:6380
REDIS_URL=redis://127.0.0.1:6380
# Confirmaciones para safe block / indexador
PERM_CACHE_CONFIRMATIONS=6
INDEXER_CONFIRMATIONS=6
INDEXER_BLOCK_CHUNK=2000
# En el stack Docker (docker-compose.yml) PORT y MONGODB_URI los fija Compose (3007 y mongo:27017).
