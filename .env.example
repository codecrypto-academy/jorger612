# Copie este archivo a `.env` en la RAÍZ del repositorio.
# Docker Compose usa estas variables al construir la imagen de la dapp (Next.js).
#
# RPC de Besu (misma red que el contrato desplegado)
RPC_URL=http://SU_VPS_O_BESU:8545
CHAIN_ID=1337
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_OWNER_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_DEPLOY_BLOCK=0

# Etiquetas honestas en la UI (no usar "Ethereum Mainnet" si es Besu/Anvil)
NETWORK_NAME=Besu RBAC
CONTRACT_DISPLAY_NAME=SecurityManager
