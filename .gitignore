# ------------------------------------------------------------------
# Reglas comunes para el proyecto RAIZ (si aplicara)
# ------------------------------------------------------------------
# Por ejemplo, ignorar la carpeta de dependencias de Foundry (si la hubiese)
# sc/node_modules/ 

# ------------------------------------------------------------------
# Reglas especificas para la subcarpeta Next.js (web/)
# ------------------------------------------------------------------

# Ignorar la carpeta de dependencias de Next.js
web/node_modules/

# Ignorar respaldos
sc/respaldo 

# Ignorar el directorio de construccion de Next.js
web/.next/


# Ignorar archivos de logs y cache de Yarn/NPM/PNPM
web/npm-debug.log*
web/yarn-debug.log*
web/yarn-error.log*
web/.pnpm-debug.log*

# Ignorar la carpeta de output de Next.js (si usas export)
web/out/

# Ignorar archivos de TypeScript autogenerados
web/*.tsbuildinfo
web/next-env.d.ts

# Ignorar cache de Vercel
web/.vercel/

# ... Tus reglas de ignorado existentes ...

# web/node_modules/
# web/.next/
# web/.env*
# ...

# ------------------------------------------------------------------
# REGLAS DE INCLUSIÓN EXPLICITA (Para asegurar que suba el código fuente)
# ------------------------------------------------------------------

# Asegurar que suban todos los archivos de configuración
# Estos archivos son la base para que el proyecto funcione en otro ambiente.
!web/package.json
!web/package-lock.json # o !web/yarn.lock si usas Yarn
!web/tsconfig.json
!web/next.config.js

# Asegurar que suba el código fuente y carpetas esenciales
# El doble asterisco (**) asegura que incluya todos los archivos en subdirectorios.
!web/public/**
!web/src/**
!web/components/**
!web/app/**

!web/.env
!web/.env.local
!web/.env.development.local
!web/.env.production.local
